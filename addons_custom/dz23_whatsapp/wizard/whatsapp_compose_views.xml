<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dz23_whatsapp_compose_form" model="ir.ui.view">
        <field name="name">dz23.whatsapp.compose.form</field>
        <field name="model">dz23.whatsapp.compose</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp">
                <group>
                    <field name="number"/>
                    <field name="body" placeholder="Digite a mensagem..."/>
                </group>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
