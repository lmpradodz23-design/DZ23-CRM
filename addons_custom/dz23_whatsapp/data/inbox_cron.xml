<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Worker do inbox: processa mensagens pendentes/devidas (FOR UPDATE SKIP
         LOCKED) com retry/backoff e DLQ. O webhook só persiste e confirma.
         noupdate=1: upgrades não reescrevem o cron (evita corrida com o próprio
         cron ativo durante o -u). -->
    <record id="cron_dz23_inbox_process" model="ir.cron">
        <field name="name">DZ23: processar inbox de WhatsApp</field>
        <field name="model_id" ref="model_dz23_message_inbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
