<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         REBRAND DOS E-MAILS: remover "Powered by Odoo".
         Preserva o link "Unfollow". Herança dos templates do módulo `mail`.
         ============================================================ -->

    <!-- mail.mail_notification_layout (rodapé "Powered by Odoo") -->
    <template id="dz23_mail_notification_layout" inherit_id="mail.mail_notification_layout"
              name="DZ23: rodapé e-mail (layout padrão)">
        <xpath expr="//div[@t-if='show_footer'][.//a[contains(@href, 'odoo.com')]]" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                <span t-if="show_unfollow" id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <!-- mail.mail_notification_light (rodapé "Powered by Odoo") -->
    <template id="dz23_mail_notification_light" inherit_id="mail.mail_notification_light"
              name="DZ23: rodapé e-mail (light)">
        <xpath expr="//td[.//a[contains(@href, 'odoo.com')]]" position="replace">
            <td align="center" style="min-width: 590px;">
                <span t-if="show_unfollow" id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </td>
        </xpath>
    </template>
</odoo>
