<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dz23_fiscal_view_move_form" model="ir.ui.view">
        <field name="name">dz23.fiscal.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botão de emissão no cabeçalho (só em fatura de cliente) -->
            <xpath expr="//header" position="inside">
                <button name="action_dz23_emit_nfe" type="object"
                        string="Emitir NF-e" class="btn-primary"
                        invisible="move_type != 'out_invoice'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <!-- Aba com os dados da NF-e -->
            <xpath expr="//notebook" position="inside">
                <page string="NF-e (DZ23)" name="dz23_nfe">
                    <group>
                        <field name="dz23_nfe_status"/>
                        <field name="dz23_nfe_key"/>
                        <field name="dz23_nfe_danfe_url" widget="url"/>
                        <field name="dz23_nfe_message"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
