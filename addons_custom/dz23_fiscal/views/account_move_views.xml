<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dz23_fiscal_view_move_form" model="ir.ui.view">
        <field name="name">dz23.fiscal.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botão de emissão: só aparece quando houver adapter homologado
                 (dz23_nfe_available). Nada de botão sem backend real. -->
            <xpath expr="//header" position="inside">
                <field name="dz23_nfe_available" invisible="1"/>
                <button name="action_dz23_emit_nfe" type="object"
                        string="Emitir NF-e" class="btn-primary"
                        invisible="move_type != 'out_invoice' or not dz23_nfe_available"
                        groups="account.group_account_invoice"/>
            </xpath>
            <!-- Aba com os dados da NF-e -->
            <xpath expr="//notebook" position="inside">
                <page string="NF-e (DZ23)" name="dz23_nfe">
                    <div class="alert alert-info" role="status"
                         invisible="dz23_nfe_available">
                        A emissão de NF-e está <b>desativada</b> até existir um
                        adapter homologado por provedor (certificado A1 + conta +
                        homologação SEFAZ). Ver ADR-002.
                    </div>
                    <group>
                        <field name="dz23_nfe_status"/>
                        <field name="dz23_nfe_key"/>
                        <field name="dz23_nfe_danfe_url" widget="url"/>
                        <field name="dz23_nfe_message"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
