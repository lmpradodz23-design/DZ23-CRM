<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Método de pagamento PIX (Woovi) -->
    <record id="payment_method_woovi" model="payment.method">
        <field name="name">Pix (Woovi)</field>
        <field name="code">woovi</field>
        <field name="sequence">10</field>
        <field name="support_tokenization" eval="False"/>
    </record>

    <!-- Provedor Woovi (começa desativado; AppID e ativação no servidor) -->
    <record id="payment_provider_woovi" model="payment.provider">
        <field name="name">Woovi (PIX)</field>
        <field name="code">woovi</field>
        <field name="state">disabled</field>
        <field name="inline_form_view_id" ref="woovi_inline_form"/>
        <field name="payment_method_ids" eval="[(4, ref('payment_method_woovi'))]"/>
    </record>
</odoo>
