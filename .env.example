# ============================================================
# DZ23 CRM — exemplo de variáveis de ambiente.
# Copie para `.env` e preencha. O `.env` NUNCA vai para o Git.
# NUNCA cole segredos reais neste arquivo de exemplo.
# Em desenvolvimento use credenciais de TESTE/sandbox; as chaves de
# produção (live) ficam só no servidor.
# ============================================================

# --- PostgreSQL (dev) — SEM default no compose: obrigatório ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=troque_esta_senha_dev

# --- Odoo — senha mestra injetada via --admin-passwd (obrigatória) ---
ODOO_MASTER_PASSWORD=troque_a_senha_mestra

# --- Evolution API (WhatsApp não-oficial) — obrigatórios (sem default) ---
EVOLUTION_API_KEY=troque_a_chave_evolution
EVO_POSTGRES_USER=evo
EVO_POSTGRES_PASSWORD=troque_a_senha_evo_db

# --- Pagamentos (Fase 5) — use chaves de TESTE em dev ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
WOOVI_APP_ID=
WOOVI_TOKEN=
WOOVI_WEBHOOK_URL=

# --- WhatsApp (Fase 3) ---
WHATSAPP_PROVIDER=twilio        # twilio | meta_cloud | ycloud | evolution | ...
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Fiscal / NF-e (Fase 4) via provedor ---
NFE_PROVIDER=                   # focusnfe | nfeio | nuvemfiscal
NFE_PROVIDER_TOKEN=

# --- OAuth Login / Calendário (Fase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Enriquecimento (Fase 6) ---
BRASILAPI_BASE=https://brasilapi.com.br/api
APIBRASIL_TOKEN=                # só se usar a versão paga
